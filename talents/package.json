    "test:e2e": "node --import tsx tests/browser.ts"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.25.9",
    "playwright": "1.63.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.6.3",
    "marked": "15.0.12",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  }
}
