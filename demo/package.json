{
  "name": "teams-talent-carddemo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/run-services.mjs",
    "start:teams": "node scripts/run-services.mjs --teams-only",
    "start:talent": "node scripts/run-services.mjs --talent-only",
    "launch": "node scripts/launch.mjs --no-open",
    "launch:teams": "node scripts/launch.mjs --teams-only --no-open",
    "launch:talent": "node scripts/launch.mjs --talent-only --no-open",
    "stop": "node scripts/stop.mjs",
    "stop:teams": "node scripts/stop.mjs --teams-only",
    "stop:talent": "node scripts/stop.mjs --talent-only",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/domain.test.ts tests/projects.test.ts tests/talent-projection.test.ts tests/project-overview.test.ts tests/project-work.test.ts tests/portability.test.ts",
    "test:e2e": "tsx tests/browser.ts",
    "test:projects:e2e": "tsx tests/projects-browser.ts",
    "test:talent:services": "tsx tests/talent-services.ts",
    "test:collaboration:e2e": "tsx tests/collaboration-cli.ts",
    "test:project-work:e2e": "tsx tests/project-work-browser.ts"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.6.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.25.9",
    "playwright": "1.63.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
